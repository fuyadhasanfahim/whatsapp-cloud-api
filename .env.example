# Copy to .env and replace placeholders. DO NOT share .env or commit it.
PORT=3000
META_APP_SECRET=replace_with_real_app_secret
WHATSAPP_VERIFY_TOKEN=replace_with_a_long_random_string
WHATSAPP_ACCESS_TOKEN=replace_with_real_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_real_phone_number_id
WHATSAPP_WABA_ID=replace_with_real_waba_id
# Use the Graph API version currently supported by your Meta app, e.g. v25.0.
WHATSAPP_API_VERSION=v25.0
